# Get your Anthropic API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Get your Groq API key at https://console.groq.com/
GROQ_API_KEY=gsk_...

# Recommended provider: anthropic (Anthropic thinks + Groq listens)
# Alternative: openrouter (one key for thinking, seeing, and listening)
DAVI_PROVIDER=anthropic
# OPENROUTER_API_KEY=sk-or-...

# AI Model: claude-sonnet-5, claude-opus-5, claude-haiku-4-5-20251001
DAVI_MODEL=claude-sonnet-5

# Voice Model (Groq / OpenRouter cloud STT): whisper-large-v3-turbo, whisper-large-v3
DAVI_WHISPER_MODEL=whisper-large-v3-turbo

# Subtract speaker playback from the mic so music/lyrics are not commands.
DAVI_ECHO_CANCEL=1

# speakers = laptop/room speakers (mic hears playback). headphones = headset mic.
DAVI_ROOM_AUDIO=speakers

# TTS voice gender: female (matches portrait) or male
DAVI_VOICE_GENDER=female

# Screenshot which display: cursor (monitor under pointer), virtual (all displays), primary
DAVI_SCREENSHOT_MONITOR=cursor

# Browser bridge shared token is NOT implemented — the Chrome extension does not send one.
# Do not set DAVI_BRIDGE_TOKEN; it would break the current extension.
